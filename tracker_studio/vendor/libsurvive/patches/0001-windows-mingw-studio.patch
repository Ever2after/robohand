diff --git a/src/studio_metrics.c b/src/studio_metrics.c
new file mode 100644
index 0000000..c000ea6
--- /dev/null
+++ b/src/studio_metrics.c
@@ -0,0 +1,27 @@
+#define SURVIVE_ENABLE_FULL_API
+#include "survive_api.h"
+#include "survive.h"
+
+/* Keep structure-dependent diagnostics inside the native build. */
+SURVIVE_EXPORT int studio_object_metrics(SurviveSimpleContext *context,
+                                        const SurviveSimpleObject *object,
+                                        double *values) {
+    SurviveObject *tracked = survive_simple_get_survive_object(object);
+    if (!tracked)
+        return 0;
+
+    survive_simple_lock(context);
+    const SurviveSensorActivations *sensors = &tracked->activations;
+    survive_long_timecode last = SurviveSensorActivations_last_time(sensors);
+    values[0] = sensors->last_light && tracked->timebase_hz > 0
+                    ? (double)(last - sensors->last_light) / tracked->timebase_hz
+                    : -1.0;
+    values[1] = sensors->last_imu != 0;
+    values[2] = tracked->sensor_ct;
+    values[3] = tracked->PoseConfidence;
+    values[4] = tracked->ison;
+    values[5] = tracked->charge;
+    values[6] = tracked->charging;
+    survive_simple_unlock(context);
+    return 1;
+}
